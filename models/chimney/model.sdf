<?xml version="1.0"?>
<!-- Open-top brick chimney: square 0.6 x 0.6 m outside, 0.36 m round flue
     (min. 0.12 m wall), 3.0 m high. Origin at the bottom centre.
     Mesh generated by scripts/gen_house_assets.py.
     Textured on purpose: stereo matching needs surface texture. -->
<sdf version="1.9">
  <model name="chimney">
    <static>true</static>
    <link name="link">
      <collision name="tube_c">
        <geometry><mesh><uri>model://chimney/meshes/chimney.obj</uri></mesh></geometry>
      </collision>
      <visual name="tube_v">
        <geometry><mesh><uri>model://chimney/meshes/chimney.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><ambient>0.8 0.8 0.8 1</ambient>
          <pbr><metal><albedo_map>model://chimney/materials/textures/brick.jpg</albedo_map>
               <roughness>0.95</roughness><metalness>0</metalness></metal></pbr>
        </material>
      </visual>
      <visual name="flue_floor">
        <pose>0 0 2.2 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.07 0.07 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
