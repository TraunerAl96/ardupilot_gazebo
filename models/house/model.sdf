<?xml version="1.0"?>
<!-- Simple gable-roof house. Origin at the ground centre.
     Body 4 m (x) x 5 m (y) x 2.5 m, 45 deg roof, ridge along y at z = 4.5 m,
     0.3 m eave overhang. The gable triangles are the upper half of a box
     rotated 45 deg about y (its lower half is hidden inside the body).
     Roof surface height at distance d from the ridge: z = 4.5 - d (+0.14 tiles).
     Textures generated by scripts/gen_house_assets.py. -->
<sdf version="1.9">
  <model name="house">
    <static>true</static>
    <link name="link">
      <!-- Walls -->
      <collision name="body_c"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>4 5 2.5</size></box></geometry></collision>
      <visual name="body_v"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>4 5 2.5</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><ambient>0.8 0.8 0.8 1</ambient>
          <pbr><metal><albedo_map>model://house/materials/textures/plaster.jpg</albedo_map>
               <roughness>0.9</roughness><metalness>0</metalness></metal></pbr>
        </material>
      </visual>

      <!-- Gables -->
      <collision name="gable_c"><pose degrees="true">0 0 2.5 0 45 0</pose><geometry><box><size>2.8284 5 2.8284</size></box></geometry></collision>
      <visual name="gable_v"><pose degrees="true">0 0 2.5 0 45 0</pose><geometry><box><size>2.8284 5 2.8284</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><ambient>0.8 0.8 0.8 1</ambient>
          <pbr><metal><albedo_map>model://house/materials/textures/plaster.jpg</albedo_map>
               <roughness>0.9</roughness><metalness>0</metalness></metal></pbr>
        </material>
      </visual>

      <!-- Roof panels (0.1 m thick, resting on the gable slopes) -->
      <collision name="roof_east_c"><pose degrees="true">1.185 0 3.385 0 45 0</pose><geometry><box><size>3.30 5.6 0.1</size></box></geometry></collision>
      <visual name="roof_east_v"><pose degrees="true">1.185 0 3.385 0 45 0</pose><geometry><box><size>3.30 5.6 0.1</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><ambient>0.8 0.8 0.8 1</ambient>
          <pbr><metal><albedo_map>model://house/materials/textures/roof_tiles.jpg</albedo_map>
               <roughness>0.85</roughness><metalness>0</metalness></metal></pbr>
        </material>
      </visual>
      <collision name="roof_west_c"><pose degrees="true">-1.185 0 3.385 0 -45 0</pose><geometry><box><size>3.30 5.6 0.1</size></box></geometry></collision>
      <visual name="roof_west_v"><pose degrees="true">-1.185 0 3.385 0 -45 0</pose><geometry><box><size>3.30 5.6 0.1</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><ambient>0.8 0.8 0.8 1</ambient>
          <pbr><metal><albedo_map>model://house/materials/textures/roof_tiles.jpg</albedo_map>
               <roughness>0.85</roughness><metalness>0</metalness></metal></pbr>
        </material>
      </visual>
      <!-- Ridge cap covering the joint of the two panels -->
      <visual name="ridge_cap"><pose degrees="true">0 0 4.56 0 45 0</pose><geometry><box><size>0.16 5.6 0.16</size></box></geometry>
        <material><ambient>0.35 0.14 0.09 1</ambient><diffuse>0.5 0.2 0.12 1</diffuse></material>
      </visual>

      <!-- Door and windows on the west (-x) face, windows on the east face -->
      <visual name="door"><pose>-2.01 0 1.0 0 0 0</pose><geometry><box><size>0.04 0.9 2.0</size></box></geometry>
        <material><ambient>0.3 0.18 0.1 1</ambient><diffuse>0.4 0.24 0.12 1</diffuse></material>
      </visual>
      <visual name="window_w1"><pose>-2.01 1.5 1.5 0 0 0</pose><geometry><box><size>0.04 0.9 0.9</size></box></geometry>
        <material><ambient>0.15 0.2 0.28 1</ambient><diffuse>0.2 0.28 0.38 1</diffuse></material>
      </visual>
      <visual name="window_w2"><pose>-2.01 -1.5 1.5 0 0 0</pose><geometry><box><size>0.04 0.9 0.9</size></box></geometry>
        <material><ambient>0.15 0.2 0.28 1</ambient><diffuse>0.2 0.28 0.38 1</diffuse></material>
      </visual>
      <visual name="window_e1"><pose>2.01 1.5 1.5 0 0 0</pose><geometry><box><size>0.04 0.9 0.9</size></box></geometry>
        <material><ambient>0.15 0.2 0.28 1</ambient><diffuse>0.2 0.28 0.38 1</diffuse></material>
      </visual>
      <visual name="window_e2"><pose>2.01 -1.5 1.5 0 0 0</pose><geometry><box><size>0.04 0.9 0.9</size></box></geometry>
        <material><ambient>0.15 0.2 0.28 1</ambient><diffuse>0.2 0.28 0.38 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
